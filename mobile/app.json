{
  "expo": {
    "name": "CaminoPlus",
    "slug": "caminoplus",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "plus.camino.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14365D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "plus.camino.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "caminoplus",
    "backgroundColor": "#F6EFE2",
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "CaminoPlus uses your photos so you can choose a profile picture and add pictures to your journey posts.",
          "cameraPermission": "CaminoPlus does not use your camera.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CaminoPlus uses your location while the app is open to show where you are on the Camino, how far you have walked and what is near you. It also uses it when you choose to send your position to friends with the help bell.",
          "locationAlwaysAndWhenInUsePermission": "CaminoPlus only uses your location while the app is open. It never tracks you in the background.",
          "locationAlwaysPermission": "CaminoPlus only uses your location while the app is open. It never tracks you in the background.",
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F6EFE2",
          "android": { "dark": { "backgroundColor": "#0F1A2B" } }
        }
      ],
      "./plugins/withStoreManifest",
      [
        "@maplibre/maplibre-react-native",
        {}
      ],
      "expo-apple-authentication",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": { "projectId": "7855e411-d3c5-48fe-8b17-fbf765962a76" }
    }
  }
}
