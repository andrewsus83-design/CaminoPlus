{
  "expo": {
    "name": "CaminoPlus",
    "slug": "caminoplus",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "plus.camino.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14365D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "plus.camino.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "caminoplus",
    "backgroundColor": "#F6EFE2",
    "plugins": [
      "expo-router",
      "expo-asset",
      ["expo-image-picker", { "photosPermission": "CaminoPlus uses your photos so you can choose a profile picture and add pictures to your journey posts." }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CaminoPlus uses your location to show where you are on the Camino, how far you have walked and what is near you, also offline.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {}
      ],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": { "projectId": "7855e411-d3c5-48fe-8b17-fbf765962a76" }
    }
  }
}
