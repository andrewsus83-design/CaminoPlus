# Copy to .env.local (never commit it). EXPO_PUBLIC_* values are compiled into the app,
# so only public keys go here. Never the service_role key.

# Optional: point the app at another Supabase project. Without these the app uses the
# CaminoPlus EU project (Frankfurt), see src/lib/config.ts.
# EXPO_PUBLIC_SUPABASE_URL=https://xgikdabgdqmbdgagowva.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# MapTiler Cloud key, ONLINE map only (terms forbid offline caching). Leave empty to
# use the OSM offline style everywhere. Restrict the key to bundle id plus.camino.app.
EXPO_PUBLIC_MAPTILER_KEY=
