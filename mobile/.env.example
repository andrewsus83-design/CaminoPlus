# Copy to .env (never commit .env). EXPO_PUBLIC_* values are compiled into the app,
# so only put public keys here (Supabase anon key and MapTiler key are public by design;
# restrict the MapTiler key to the app's bundle id in the MapTiler dashboard).

# Supabase EU project (Frankfurt)
EXPO_PUBLIC_SUPABASE_URL=https://xgikdabgdqmbdgagowva.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MapTiler Cloud key, ONLINE map only (terms forbid offline caching). Leave empty to
# use the OSM offline style everywhere.
EXPO_PUBLIC_MAPTILER_KEY=
